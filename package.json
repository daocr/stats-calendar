{
  "name": "stats-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "verify:source": "node scripts/verify-source.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260921.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  }
}
